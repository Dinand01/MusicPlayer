    "features": {
      "file": "docs/features.md",
      "update_on": [
        "new feature added",
        "feature modified",
        "deprecated feature removed"
      ]
    },
    "technology_stack": {
      "file": "docs/technology-stack.md",
      "update_on": [
        "library added",
        "library updated",
        "dependency removed",
        "new technology adopted"
      ]
    },
    "how_it_works": {
      "file": "docs/how-it-works.md",
      "update_on": [
        "new workflow documented",
        "inner working changed",
        "algorithm modified",
        "flow diagram updated"
      ]
    },
    "api": {
      "file": "docs/api.md",
      "update_on": [
        "API endpoint added",
        "function signature changed",
        "state model modified",
        "protocol changed"
      ]
    },
    "index": {
      "file": "docs/index.md",
      "update_on": [
