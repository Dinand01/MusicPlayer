<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>MusicPlayerWeb</AssemblyName>
    <RootNamespace>MusicPlayerWeb</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>play_button.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CefGlue.Common" />
    <PackageReference Include="CefGlue.Avalonia" />
    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MusicPlayer/MusicPlayer.csproj" />
    <ProjectReference Include="../CefGlue.BrowserProcess/CefGlue.BrowserProcess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="play_button.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

<Target Name="CopyCustomBrowserProcess" AfterTargets="AfterBuild">
  <PropertyGroup>
    <BrowserProcessSourceDir>$(ProjectDir)../CefGlue.BrowserProcess/bin/$(Configuration)/net10.0</BrowserProcessSourceDir>
    <BrowserProcessTargetDir>$(OutputPath)CefGlueBrowserProcess</BrowserProcessTargetDir>
  </PropertyGroup>
  
  <RemoveDir Directories="$(BrowserProcessTargetDir)" />
  <MakeDir Directories="$(BrowserProcessTargetDir)" />
  
  <ItemGroup>
    <BrowserProcessFiles Include="$(BrowserProcessSourceDir)/**/*" />
  </ItemGroup>
  
  <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessTargetDir)/%(RecursiveDir)" />
  
  <Message Text="Copied custom .NET 10 BrowserProcess to $(BrowserProcessTargetDir)" Importance="high" />
</Target>

</Project>
