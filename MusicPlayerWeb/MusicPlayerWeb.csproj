<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MusicPlayerWeb</RootNamespace>
    <AssemblyName>MusicPlayerWeb</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>play_button.ico</ApplicationIcon>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf" Version="128.4.90" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicPlayer\MusicPlayer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties\Resources.resx" />
    <!-- CefSharp temporarily disabled - vcredist files not needed -->
    <!-- <EmbeddedResource Include="redist\vcredist_x64_1.exe" /> -->
    <!-- <EmbeddedResource Include="redist\vcredist_x64_2.exe" /> -->
    <!-- <EmbeddedResource Include="redist\vcredist_x86_1.exe" /> -->
    <!-- <EmbeddedResource Include="redist\vcredist_x86_2.exe" /> -->
    <EmbeddedResource Include="Resources\DirbleApiKey.dirbleapikey" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CefSharp.Example.Handlers\**\*.*" />
  </ItemGroup>

</Project>
